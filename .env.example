# Copy to .env (never commit .env). Nothing secret is required: the configured models are ungated.

# Only needed for gated Hugging Face repositories (unsloth/Llama-3.1-8B-Instruct and the EAGLE-3 head are public).
HF_TOKEN=
# Model and dataset cache (about 16 GB of BF16 weights plus the draft head).
HF_HOME=$HOME/.cache/huggingface
# 1 on compute nodes without internet, after scripts/slurm/prefetch.sh has filled HF_HOME.
HF_HUB_OFFLINE=0

# First port for this job's vLLM servers (one server per GPU slot); set per Slurm job to avoid clashes.
HARNESS_BASE_PORT=8100
# Unix time after which no new engine group starts (set from the Slurm job end by scripts/slurm/harness.sbatch).
HARNESS_DEADLINE=

# Set by Slurm; the harness gives each vllm serve one GPU.
CUDA_VISIBLE_DEVICES=0,1

# Note: VLLM_SERVER_DEV_MODE=1 and VLLM_MAX_STOP_STRINGS=16 are set by the harness itself for every server
# (harness/engine/vllm_flags.py); do not set them here.
